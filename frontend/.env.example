# Copy to .env for local overrides. Never commit the .env file.

# Base URL of the backend API.
# Leave empty for local dev (Vite proxies /api to http://localhost:8080).
# For production (Vercel frontend + Render backend), set e.g.:
# VITE_API_BASE_URL=https://babysitter-api.onrender.com/api
VITE_API_BASE_URL=

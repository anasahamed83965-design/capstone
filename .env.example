# Copy to .env and fill in real values. Never commit the .env file.

# --- Database ---
# Default is PostgreSQL running via Docker (see docker-compose or run: docker run -d --name babysitter-postgres -e POSTGRES_DB=babysitter_db -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:17-alpine)
# For local Postgres (Docker) - defaults work out of the box, leave commented to use defaults:
# DB_URL=jdbc:postgresql://localhost:5432/babysitter_db
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# For MySQL instead:
# DB_URL=jdbc:mysql://localhost:3306/babysitter_db?createDatabaseIfNotExist=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=your_db_password

# --- Server (Render/Railway set PORT automatically) ---
PORT=8080

# --- CORS (comma-separated; add your Vercel URL in production) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# --- SMTP (optional, for booking emails) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your_app_password

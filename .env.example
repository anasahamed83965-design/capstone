# Copy to .env and fill in real values. Never commit the .env file.

# --- Database ---
# Default is H2 file-based (./data/babysitter_db) - no setup needed, data survives restarts.
# Leave these commented out for H2. Uncomment for MySQL instead:
# DB_URL=jdbc:mysql://localhost:3306/babysitter_db?createDatabaseIfNotExist=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=your_db_password

# --- Server (Render/Railway set PORT automatically) ---
PORT=8080

# --- CORS (comma-separated; add your Vercel URL in production) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# --- SMTP (optional, for booking emails) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your_app_password
